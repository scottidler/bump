# The only global git config the test suite sees (wired in .cargo/config.toml).
# init.defaultBranch is deliberately NOT main: a fixture that relies on the host's
# default branch fails here on every machine, not only on a host set to master.
[init]
	defaultBranch = fixture-default-is-not-main
[user]
	name = Test
	email = test@test.com
[commit]
	gpgsign = false
[tag]
	gpgsign = false
# Cargo's [env] also reaches build.rs (build-version runs git). In a CI container the
# checkout is owned by another uid and actions/checkout trusts it in the global config
# this file replaces, so trust every directory here or the build dies on dubious ownership.
[safe]
	directory = *
